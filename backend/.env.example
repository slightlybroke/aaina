SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-locally
SUPABASE_SERVICE_ROLE_KEY=server-only-replace-locally
YOUCAM_API_KEY=server-only-replace-locally
# Optional: conversational look planning; never copy this key to Flutter.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_SESSION_SECONDS=300
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
STORAGE_BUCKET=analysis-incoming
CORS_ORIGINS=["http://localhost:3000"]
POLL_SECONDS=10
JOB_TIMEOUT_SECONDS=1800
IMAGE_TTL_SECONDS=3600
# Exact provider-owned asset hosts only; update after inspecting your real response.
YOUCAM_ASSET_HOSTS=["yce-us.s3-accelerate.amazonaws.com"]
# Enable only after applying the VTO migration and reviewing account entitlement/cost.
YOUCAM_VTO_ENABLED=false
